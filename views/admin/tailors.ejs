<!DOCTYPE html>
<html lang="en">
<head><title>Tailors | StitchStudio</title><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<div class="page-wrap">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="page-title mb-0">Tailors & Fabric Cutters</div>
    <button class="btn btn-primary-boutique" data-bs-toggle="modal" data-bs-target="#addTailor"><i class="bi bi-plus-lg"></i> Add Tailor</button>
  </div>

  <div class="card-soft">
    <table class="table table-boutique align-middle">
      <thead><tr><th>Name</th><th>Contact</th><th>Specialization</th><th>Weekly Capacity</th><th>Current Load</th></tr></thead>
      <tbody>
        <% tailors.forEach(t => { %>
          <tr>
            <td><%= t.name %></td>
            <td><%= t.email %><br><span class="text-muted small"><%= t.phone %></span></td>
            <td><%= t.specialization || '—' %></td>
            <td><%= t.capacity_per_week %> orders/week</td>
            <td style="min-width:160px;">
              <% const pct = Math.min(100, Math.round((t.active_orders / (t.capacity_per_week||1)) * 100)); %>
              <div class="d-flex justify-content-between small"><span><%= t.active_orders %> active</span><span><%= pct %>%</span></div>
              <div class="capacity-bar"><div class="capacity-fill" style="width:<%= pct %>%; background: <%= pct >= 90 ? '#b3413a' : (pct >= 60 ? '#c98a2c' : '#3f8f5f') %>;"></div></div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Add Tailor Modal -->
<div class="modal fade" id="addTailor" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/tailors">
        <div class="modal-header"><h5 class="modal-title">Add New Tailor / Fabric Cutter</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
          <div class="mb-2"><label class="form-label">Name</label><input class="form-control" name="name" required></div>
          <div class="mb-2"><label class="form-label">Email (used to login)</label><input type="email" class="form-control" name="email" required></div>
          <div class="mb-2"><label class="form-label">Temporary Password</label><input class="form-control" name="password" required minlength="6"></div>
          <div class="mb-2"><label class="form-label">Phone</label><input class="form-control" name="phone"></div>
          <div class="mb-2"><label class="form-label">Weekly Capacity (max orders)</label><input type="number" class="form-control" name="capacity_per_week" value="5" min="1"></div>
          <div class="mb-2"><label class="form-label">Specialization</label><input class="form-control" name="specialization" placeholder="e.g. Blouses, Sarees"></div>
        </div>
        <div class="modal-footer"><button class="btn btn-primary-boutique">Add Tailor</button></div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
