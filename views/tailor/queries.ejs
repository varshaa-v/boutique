<!DOCTYPE html>
<html lang="en">
<head><title>Queries | StitchStudio</title><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<div class="page-wrap">
  <div class="page-title">Raise a Query</div>

  <div class="row g-3">
    <div class="col-lg-5">
      <div class="card-soft">
        <div class="section-title">New Query</div>
        <% if (myOrders.length === 0) { %>
          <p class="text-muted small">You have no active orders to raise a query on.</p>
        <% } else { %>
          <form method="POST" action="/tailor/queries">
            <div class="mb-2">
              <label class="form-label">Order</label>
              <select class="form-select" name="order_id" required>
                <% myOrders.forEach(o => { %>
                  <option value="<%= o.id %>">#<%= o.id %> — <%= o.garment_type %> (due <%= o.due_date %>)</option>
                <% }) %>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label">Query Type</label>
              <select class="form-select" name="query_type" required>
                <option value="insufficient_fabric">Insufficient Fabric</option>
                <option value="insufficient_thread">Insufficient Thread</option>
                <option value="unable_to_complete">Unable to Complete by Deadline</option>
                <option value="deadline_extension">Requesting Deadline Extension</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label">Message</label>
              <textarea class="form-control" name="message" rows="4" required placeholder="Explain the issue to the admin..."></textarea>
            </div>
            <button class="btn btn-primary-boutique w-100">Submit Query</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="col-lg-7">
      <div class="card-soft">
        <div class="section-title">Your Query History</div>
        <% if (queries.length === 0) { %>
          <p class="text-muted small">No queries raised yet.</p>
        <% } %>
        <% queries.forEach(q => { %>
          <div class="border-bottom pb-2 mb-2">
            <span class="badge-status <%= q.status === 'open' ? 'status-query_raised' : 'status-completed' %>"><%= q.status %></span>
            <strong class="ms-1">#<%= q.order_id %> <%= q.garment_type %></strong>
            <span class="text-muted small float-end"><%= q.created_at %></span>
            <div class="small text-muted"><%= q.query_type.replace(/_/g,' ') %></div>
            <div><%= q.message %></div>
            <% if (q.admin_response) { %><div class="text-muted small mt-1"><strong>Admin:</strong> <%= q.admin_response %></div><% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
</body>
</html>
