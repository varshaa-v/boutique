<!DOCTYPE html>
<html lang="en">
<head><title>Messages | StitchStudio</title><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<div class="page-wrap">
  <div class="page-title">Messages from Admin</div>
  <div class="card-soft">
    <% if (messages.length === 0) { %>
      <div class="empty-state"><i class="bi bi-chat-dots"></i><p class="mt-2">No messages yet.</p></div>
    <% } %>
    <% messages.forEach(m => { %>
      <div class="border-bottom pb-2 mb-2">
        <strong><%= m.subject || '(No subject)' %></strong>
        <% if (m.order_id) { %><span class="text-muted small"> · Order #<%= m.order_id %></span><% } %>
        <span class="text-muted small float-end"><%= m.created_at %></span>
        <div class="text-muted small">From: <%= m.sender_name %></div>
        <div><%= m.message %></div>
      </div>
    <% }) %>
  </div>
</div>
</body>
</html>
